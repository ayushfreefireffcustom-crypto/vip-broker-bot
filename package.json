{
  "name": "vip-broker-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram VIP broker-verification funnel bot",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bot": "tsx src/bot/main.ts",
    "bot:dev": "tsx watch src/bot/main.ts",
    "sync": "tsx src/sync/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "grammy": "^1.34.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
