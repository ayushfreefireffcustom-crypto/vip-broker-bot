# ── Telegram ──────────────────────────────────────────────────────────────
# BotFather token for OUR bot (never commit the real one).
BOT_TOKEN=

# The private VIP channel the bot grants access to. Numeric id like -1001234567890.
# The bot MUST be an admin of this channel with "invite users" permission.
VIP_CHANNEL_ID=

# The admin group where pending cases are posted with Approve/Reject buttons.
ADMIN_GROUP_ID=

# Comma-separated Telegram user ids allowed to approve/reject and run admin commands.
ADMIN_IDS=

# ── Runtime mode ──────────────────────────────────────────────────────────
# "poll" (dev, long-polling) or "webhook" (prod). Default: poll.
BOT_MODE=poll
# Public https base for webhook mode, e.g. https://bot.example.com
WEBHOOK_DOMAIN=
# Port the webhook http server listens on (webhook mode + /health).
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Eligibility rules ─────────────────────────────────────────────────────
# Minimum funded deposits (USD) and minimum traded volume (lots) to pass the check.
MIN_DEPOSIT_USD=100
MIN_VOLUME_LOTS=0.1
# How old the synced referred-clients list may be before "checking" falls back
# to manual review instead of trusting a stale list (minutes).
LIST_STALE_MINUTES=180

# ── Sync worker ───────────────────────────────────────────────────────────
# Directory holding per-broker CSV exports named <broker>.csv (vantage.csv, …).
# This is the "manual CSV" floor source; scrape/API sources plug in behind the
# same ClientListSource interface once the build-time spike confirms them.
SYNC_CSV_DIR=./data
SYNC_INTERVAL_MINUTES=30

# ── Rate limiting + reminders ─────────────────────────────────────────────
RATE_WINDOW_MS=10000
RATE_MAX=12
# Nudge a user stalled mid-funnel after this many minutes of inactivity.
STALE_FUNNEL_MINUTES=120
REMINDER_INTERVAL_MINUTES=60

# ── Helper images (optional) ──────────────────────────────────────────────
# Shown when a user picks a broker ("where to find your UID/email"). A Telegram
# file_id or an https URL. Leave empty to send a plain text prompt instead.
HELP_IMAGE_VANTAGE=
HELP_IMAGE_EXNESS=
HELP_IMAGE_XM=

# ── Partner / referral links ──────────────────────────────────────────────
# Sent when a user's account isn't found under our link (so they can register).
REF_LINK_VANTAGE=
REF_LINK_EXNESS=
REF_LINK_XM=

# ── Brand copy ────────────────────────────────────────────────────────────
# OUR brand name shown in bot copy (do NOT impersonate any real brand).
BRAND_NAME=VIP Access

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
